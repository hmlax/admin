{
  "name": "go-admin-frontends",
  "version": "6.0.0",
  "description": "Go Admin React administration platform",
  "repository": "github.com/hmlax/admin.git",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:platform",
    "build": "npm run build:platform && npm run build:merchant",
    "build:check": "npm run typecheck && npm run build",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.node.json --noEmit",
    "test:tenant-routes": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "test:list-height": "node scripts/check-list-heights.mjs",
    "preview": "npm run preview --workspace @go-admin/platform-admin",
    "preview:platform": "npm run preview --workspace @go-admin/platform-admin",
    "preview:merchant": "npm run preview --workspace @go-admin/merchant-admin",
    "dev:platform": "npm run dev --workspace @go-admin/platform-admin",
    "dev:merchant": "npm run dev --workspace @go-admin/merchant-admin",
    "build:platform": "npm run build --workspace @go-admin/platform-admin",
    "build:merchant": "npm run build --workspace @go-admin/merchant-admin"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@tanstack/react-query": "^5.100.11",
    "antd": "^6.4.3",
    "axios": "^1.16.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "exceljs": "^4.4.0",
    "i18next": "^26.2.0",
    "lodash": "^4.18.1",
    "lodash.clonedeep": "^4.5.0",
    "nprogress": "^0.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.26.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@types/archiver": "^6.0.4",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.21",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.12.4",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "archiver": "^7.0.1",
    "commitlint": "^21.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^4.22.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "less": "^4.6.4",
    "lint-staged": "^17.0.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "unplugin-auto-import": "^20.3.0",
    "vite": "^8.0.13",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.6"
  },
  "private": true,
  "workspaces": [
    "platform-admin",
    "merchant-admin"
  ]
}
