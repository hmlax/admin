# Git files
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Documentation
*.md
README.md
docs/

# Docker files (not needed inside image)
Dockerfile
docker-compose*.yaml
.dockerignore

# Build artifacts
bin/
**/bin/
dist/
build/

# Windows / local build binaries (hundreds of MB each, keep out of build context)
*.exe
**/*.exe

# Test files
*_test.go
testdata/

# Scripts (if not needed at runtime)
platform/scripts/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Dependencies (will be downloaded during build)
vendor/

# Secrets / env (compose reads .env on the host; never baked into image layers)
.env

# SQL seed/migration dumps (not needed for image build)
platform/sql/
.env.*
**/node_modules/
/data/
platform/deploy/infra/nacos/*.yaml
platform/artifacts/
